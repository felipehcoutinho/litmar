# Configuración de litmar.
#
# Copia este fichero como .env y rellena lo que necesites:
#     cp .env.example .env
# El .env no se sube a git. `litmar` (CLI e interfaz web) lo lee del directorio
# donde lo ejecutes; las variables ya definidas en el entorno tienen prioridad.
#
# Todo es opcional: Europe PMC, arXiv y PANGAEA no necesitan nada, y OpenAlex y
# Crossref funcionan sin clave. Deja vacío lo que no uses.

# --- OpenAlex ---------------------------------------------------------------
# Clave gratuita en https://openalex.org/settings/api
# Sin ella se comparte un presupuesto diario por IP; con ella el tuyo es propio y mayor.
OPENALEX_API_KEY=

# --- Crossref ---------------------------------------------------------------
# Correo de contacto para entrar en el "polite pool" (límites más altos).
# Se envía a Crossref en cada petición.
CROSSREF_MAILTO=

# --- Zotero -----------------------------------------------------------------
# Biblioteca en la que buscar: rellena SOLO UNA de las dos (son números).
#   - Usuario: "Your user ID" en https://www.zotero.org/settings/keys
#   - Grupo: el número que aparece en la URL del grupo
# Sin ninguna de las dos, Zotero no aparece entre las fuentes.
ZOTERO_USER_ID=
ZOTERO_GROUP_ID=
# Solo para bibliotecas privadas. Se crea en https://www.zotero.org/settings/keys
ZOTERO_API_KEY=

# --- Modelos de lenguaje ----------------------------------------------------
# Elige una configuración y rellena la clave correspondiente:
LITMAR_MODELO=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
# Ejemplos:
# LITMAR_MODELO=google_genai:gemini-3.8-flash
# LITMAR_MODELO=anthropic:claude-sonnet-5-5
